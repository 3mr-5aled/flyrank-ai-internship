# LLM Provider Configuration (Supports OpenAI, OpenRouter, Gemini OpenAI-compatible, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Smart Mock Fallback: When set to 'true', simulates intelligent AI responses if API key is missing or quota exceeded
LLM_MOCK_FALLBACK=true

# Inngest Configuration
# For local development with Inngest Dev Server (npm run inngest:dev), keys are optional.
INNGEST_EVENT_KEY=local-dev-event-key
INNGEST_SIGNING_KEY=local-dev-signing-key
INNGEST_DEV=1
