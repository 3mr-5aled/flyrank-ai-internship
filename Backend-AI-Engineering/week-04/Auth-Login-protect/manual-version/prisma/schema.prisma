generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model task {
  id         Int       @id @default(autoincrement())
  title      String
  done       Boolean   @default(false)
  created_at DateTime? @default(now())
  updated_at DateTime? @default(now())

  @@map("tasks")
}
